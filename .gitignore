/target
**/*.rs.bk

# Local environment variables and secrets
.env

# GCP service account key (Cloud Run deploy)
key.json

# Local agent run history/cache
history.json

# The agentcfg binary `just agentcfg` fetches. Downloaded per pin, never
# committed — Renovate collects post-upgrade changes from `git status`, so an
# unignored copy would land three megabytes in a pull request about prose.
/.agentcfg/
